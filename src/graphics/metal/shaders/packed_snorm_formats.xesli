float XePackedSNormComponent(uint code, uint bits) {
  int value = int(code << (32u - bits)) >> int(32u - bits);
  int max_value = bits == 1u ? 1 : int((1u << (bits - 1u)) - 1u);
  return float(value < -max_value ? -max_value : value) / float(max_value);
}

void XeDXT3SNormTexel(uint color, uint alpha, out_param_xe(uint4_xe, texel)) {
  texel = float_bits_to_uint_xe(float4_xe(
      XePackedSNormComponent(color & 255u, 8u),
      XePackedSNormComponent((color >> 8u) & 255u, 8u),
      XePackedSNormComponent((color >> 16u) & 255u, 8u),
      XePackedSNormComponent(alpha & 15u, 4u)));
}

uint4_xe XeR5G5B5A1SNormToRGBA32F(uint packed) {
  return float_bits_to_uint_xe(float4_xe(
      XePackedSNormComponent(packed & 31u, 5u),
      XePackedSNormComponent((packed >> 5u) & 31u, 5u),
      XePackedSNormComponent((packed >> 10u) & 31u, 5u),
      XePackedSNormComponent((packed >> 15u) & 1u, 1u)));
}
