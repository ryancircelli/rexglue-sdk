+// Pack four DXT3 alpha nibbles into RG16 values. R stores the exact unsigned
+// 4-bit fraction expanded to UNORM16; G stores the signed interpretation
+// expanded to SNORM16. 65535 / 15 and 32767 / 7 are exact integers.
+uint XeDXT3AByteToRG16(uint alpha_byte) {
+  uint nibble = alpha_byte & 15u;
+  uint unorm = nibble * 4369u;
+  int signed_nibble = int(nibble) - ((nibble & 8u) != 0u ? 16 : 0);
+  signed_nibble = max(signed_nibble, -7);
+  uint snorm = uint(signed_nibble * 4681) & 0xFFFFu;
+  return unorm | (snorm << 16u);
+}
+uint4_xe XeDXT3AByteWordToRG16(uint packed_alpha_bytes) {
+  return uint4_xe(
+      XeDXT3AByteToRG16(packed_alpha_bytes),
+      XeDXT3AByteToRG16(packed_alpha_bytes >> 8u),
+      XeDXT3AByteToRG16(packed_alpha_bytes >> 16u),
+      XeDXT3AByteToRG16(packed_alpha_bytes >> 24u));
+}
