}

void XeR5G5B5A1SNormToRGBA32F(
    uint4_xe packed, out_param_xe(uint4_xe, out_0),
    out_param_xe(uint4_xe, out_1), out_param_xe(uint4_xe, out_2),
    out_param_xe(uint4_xe, out_3), out_param_xe(uint4_xe, out_4),
    out_param_xe(uint4_xe, out_5), out_param_xe(uint4_xe, out_6),
    out_param_xe(uint4_xe, out_7)) {
  out_0 = XeR5G5B5A1SNormToRGBA32F(packed.x & 0xFFFFu);
  out_1 = XeR5G5B5A1SNormToRGBA32F(packed.x >> 16u);
  out_2 = XeR5G5B5A1SNormToRGBA32F(packed.y & 0xFFFFu);
  out_3 = XeR5G5B5A1SNormToRGBA32F(packed.y >> 16u);
  out_4 = XeR5G5B5A1SNormToRGBA32F(packed.z & 0xFFFFu);
  out_5 = XeR5G5B5A1SNormToRGBA32F(packed.z >> 16u);
  out_6 = XeR5G5B5A1SNormToRGBA32F(packed.w & 0xFFFFu);
  out_7 = XeR5G5B5A1SNormToRGBA32F(packed.w >> 16u);
}
