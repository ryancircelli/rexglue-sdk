+// Convert packed hendeca codes directly to float32 texels. The float
+// representation preserves the exact source-code ratio through Metal sampling.
+uint4_xe XeR10G11B11UNormToRGBA32F(uint packed_texel) {
+  return float_bits_to_uint_xe(
+      float4_xe(packed_texel & 1023u, (packed_texel >> 10u) & 2047u,
+                packed_texel >> 21u, 2047u) *
+      float4_xe(1.0f / 1023.0f, 1.0f / 2047.0f,
+                1.0f / 2047.0f, 1.0f));
+}
+void XeR10G11B11UNormToRGBA32F(
+    uint4_xe packed, out_param_xe(uint4_xe, out_0),
+    out_param_xe(uint4_xe, out_1), out_param_xe(uint4_xe, out_2),
+    out_param_xe(uint4_xe, out_3)) {
+  out_0 = XeR10G11B11UNormToRGBA32F(packed.x);
+  out_1 = XeR10G11B11UNormToRGBA32F(packed.y);
+  out_2 = XeR10G11B11UNormToRGBA32F(packed.z);
+  out_3 = XeR10G11B11UNormToRGBA32F(packed.w);
+}
+uint4_xe XeR11G11B10UNormToRGBA32F(uint packed_texel) {
+  return float_bits_to_uint_xe(
+      float4_xe(packed_texel & 2047u, (packed_texel >> 11u) & 2047u,
+                (packed_texel >> 22u) & 1023u, 1023u) *
+      float4_xe(1.0f / 2047.0f, 1.0f / 2047.0f,
+                1.0f / 1023.0f, 1.0f));
+}
+void XeR11G11B10UNormToRGBA32F(
+    uint4_xe packed, out_param_xe(uint4_xe, out_0),
+    out_param_xe(uint4_xe, out_1), out_param_xe(uint4_xe, out_2),
+    out_param_xe(uint4_xe, out_3)) {
+  out_0 = XeR11G11B10UNormToRGBA32F(packed.x);
+  out_1 = XeR11G11B10UNormToRGBA32F(packed.y);
+  out_2 = XeR11G11B10UNormToRGBA32F(packed.z);
+  out_3 = XeR11G11B10UNormToRGBA32F(packed.w);
+}
+uint4_xe XeR10G11B11SNormToRGBA32F(uint packed_texel) {
+  int r = int(packed_texel << 22u) >> 22;
+  int g = int(packed_texel << 11u) >> 21;
+  int b = int(packed_texel) >> 21;
+  float4_xe codes = float4_xe(r, g, b, 1);
+  codes = max(codes, float4_xe(-511, -1023, -1023, 1));
+  return float_bits_to_uint_xe(
+      codes * float4_xe(1.0f / 511.0f, 1.0f / 1023.0f,
+                        1.0f / 1023.0f, 1.0f));
+}
+void XeR10G11B11SNormToRGBA32F(
