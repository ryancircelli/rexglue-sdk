#include "texture_load.xesli"

XE_TEXTURE_LOAD_ENTRY(16)
{
  XeTextureLoadInfo load_info = XeTextureLoadGetInfo(pass_push_consts_xe);
  uint3_xe block_index = in_global_thread_id_xe << uint3_xe(4u, 0u, 0u);
  dont_flatten_xe
  if (any(greater_than_equal_xe(block_index.xy, load_info.size_blocks.xy))) {
    return;
  }
  uint block_offset_host =
      load_info.host_offset +
      uint(XeTextureHostLinearOffset(int3_xe(block_index), load_info.host_pitch,
                                     load_info.size_blocks.y, 16u));
  uint block_offset_guest =
      XeTextureLoadSourceAddress(load_info, block_index, 1u);
  uint4_xe guest_blocks = XeEndianSwap16(
      byte_buffer_align16_load16_xe(xe_texture_load_source, block_offset_guest),
      load_info.endian_32);
  uint4_xe texel_0, texel_1, texel_2, texel_3;
  uint4_xe texel_4, texel_5, texel_6, texel_7;
  XE_TEXTURE_LOAD_16BPB_TO_128BPB(guest_blocks, texel_0, texel_1, texel_2,
                                   texel_3, texel_4, texel_5, texel_6,
                                   texel_7);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host,
                                 texel_0);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 16u,
                                 texel_1);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 32u,
                                 texel_2);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 48u,
                                 texel_3);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 64u,
                                 texel_4);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 80u,
                                 texel_5);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 96u,
                                 texel_6);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 112u,
                                 texel_7);

  block_offset_host += 128u;
  block_offset_guest +=
      XeTextureLoadLocalXAddressXor(8u, 1u, load_info.is_tiled);
  guest_blocks = XeEndianSwap16(
      byte_buffer_align16_load16_xe(xe_texture_load_source, block_offset_guest),
      load_info.endian_32);
  XE_TEXTURE_LOAD_16BPB_TO_128BPB(guest_blocks, texel_0, texel_1, texel_2,
                                   texel_3, texel_4, texel_5, texel_6,
                                   texel_7);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host,
                                 texel_0);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 16u,
                                 texel_1);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 32u,
                                 texel_2);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 48u,
                                 texel_3);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 64u,
                                 texel_4);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 80u,
                                 texel_5);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 96u,
                                 texel_6);
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host + 112u,
                                 texel_7);
}
entry_code_end_compute_xe
